<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrvaApp.Rezultat"
             Title="Results">
    <Grid>
        <Image Source="background.jpg" Opacity="0.3" Aspect="AspectFill"/>
        <VerticalStackLayout Padding="15">
            <Grid Padding="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="klik1"/>
                </Grid.GestureRecognizers>
                <Border Grid.Column="0" BackgroundColor="CornflowerBlue" StrokeShape="RoundRectangle 10">
                    <Image
            x:Name="prvaslika"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            />
                    <Border.Shadow>
                        <Shadow
                            Brush="#80000000"
                            Offset="0,8"
                            Radius="15" />
                        </Border.Shadow>
                </Border>
                <Border Grid.Column="1" BackgroundColor="CornflowerBlue" StrokeShape="RoundRectangle 35">
                    <Label
            x:Name="prvitekst"
                    TextColor="White"
            Text="test"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center"
            />
                    <Border.Shadow>
                        <Shadow
        Brush="#80000000"
        Offset="0,8"
        Radius="15" />
                    </Border.Shadow>
                </Border>
            </Grid>
            <Grid Padding="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="klik2"/>
                </Grid.GestureRecognizers>
                <Border Grid.Column="0" BackgroundColor="Transparent" StrokeShape="RoundRectangle 10">
                    <Image
    x:Name="drugaslika"
    Aspect="AspectFill"
    HorizontalOptions="Fill"
    />
                    <Border.Shadow>
                        <Shadow
        Brush="#80000000"
        Offset="0,8"
        Radius="15" />
                    </Border.Shadow>
                </Border>
                <Border Grid.Column="1" BackgroundColor="CornflowerBlue" StrokeShape="RoundRectangle 35">
                    <Label
    x:Name="drugitekst"
    Text="test"
                    TextColor="White"
    HorizontalTextAlignment="Center"
    VerticalTextAlignment="Center"
    />
                    <Border.Shadow>
                        <Shadow
        Brush="#80000000"
        Offset="0,8"
        Radius="15" />
                    </Border.Shadow>
                </Border>
            </Grid>
            <Grid Padding="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="klik3"/>
                </Grid.GestureRecognizers>
                <Border Grid.Column="0" BackgroundColor="Transparent" StrokeShape="RoundRectangle 10">
                    <Image
    x:Name="trecaslika"
    Aspect="AspectFill"
    HorizontalOptions="Fill"
    />
                    <Border.Shadow>
                        <Shadow
        Brush="#80000000"
        Offset="0,8"
        Radius="15" />
                    </Border.Shadow>
                </Border>
                <Border Grid.Column="1" BackgroundColor="CornflowerBlue" StrokeShape="RoundRectangle 35">
                    <Label
    x:Name="trecitekst"
    Text="test"
                    TextColor="White"
    HorizontalTextAlignment="Center"
    VerticalTextAlignment="Center"
    />
                    <Border.Shadow>
                        <Shadow
        Brush="#80000000"
        Offset="0,8"
        Radius="15" />
                    </Border.Shadow>
                </Border>
            </Grid>
            <Grid Padding="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="klik4"/>
                </Grid.GestureRecognizers>
                <Border Grid.Column="0" BackgroundColor="Transparent" StrokeShape="RoundRectangle 10">
                    <Image
    x:Name="cetvrtaslika"
    Aspect="AspectFill"
    HorizontalOptions="Fill"
    />
                    <Border.Shadow>
                        <Shadow
        Brush="#80000000"
        Offset="0,8"
        Radius="15" />
                    </Border.Shadow>
                </Border>
                <Border Grid.Column="1" BackgroundColor="CornflowerBlue" StrokeShape="RoundRectangle 35">
                    <Label
    x:Name="cetvrtitekst"
    Text="test"
                    TextColor="White"
    HorizontalTextAlignment="Center"
    VerticalTextAlignment="Center"
    />
                    <Border.Shadow>
                        <Shadow
        Brush="#80000000"
        Offset="0,8"
        Radius="15" />
                    </Border.Shadow>
                </Border>
            </Grid>
            <Grid Padding="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="klik5"/>
                </Grid.GestureRecognizers>
                <Border Grid.Column="0" BackgroundColor="Transparent" StrokeShape="RoundRectangle 10">
                    <Image
    x:Name="petaslika"
    Aspect="AspectFill"
    HorizontalOptions="Fill"
    />
                    <Border.Shadow>
                        <Shadow
        Brush="#80000000"
        Offset="0,8"
        Radius="15" />
